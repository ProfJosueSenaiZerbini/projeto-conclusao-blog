<section class="section-resenhas">
  <!-- Cabeçalho da Seção -->
  <div class="section-header">
    <div class="badge-secao">SEÇÃO <span>✦</span></div>
    <h1 class="main-title">Resenhas</h1>
    <p class="subtitle">
      Análises honestas e apaixonadas sobre livros, filmes, séries, exposições, teatro, shows e álbuns.
    </p>

    <!-- Filtros por Categoria -->
    <ul class="filter-list">
      <li><a href="#" class="active">TODOS</a></li>
      <li><a href="#">LIVROS</a></li>
      <li><a href="#">FILMES</a></li>
      <li><a href="#">SÉRIES</a></li>
      <li><a href="#">EXPOSIÇÕES</a></li>
      <li><a href="#">TEATRO</a></li>
      <li><a href="#">SHOWS</a></li>
      <li><a href="#">ÁLBUNS</a></li>
    </ul>
  </div>

  <!-- Divisória Destaque -->
  <div class="destaque-header">
    <span class="tag-destaque">EM DESTAQUE</span>
    <span class="diamonds">♦ ♦ ♦</span>
  </div>

  <!-- Grid de Cards -->
  <div class="cards-grid">
    <!-- Card 1 -->
    <article class="card">
      <div class="tape tape-yellow"></div>
      <div class="card-img-wrapper">
        <img src="caminho-da-imagem-1.jpg" alt="Torto Arado">
        <span class="category-badge badge-red">LIVRO</span>
      </div>
      <div class="card-content">
        <div class="stars">★★★★★</div>
        <h2 class="card-title">Torto Arado</h2>
        <p class="author">Itamar Vieira Junior</p>
        <p class="description">
          Uma obra monumental sobre terra, memória e resistência no sertão baiano. Vieira Junior tece narrativas de
          mulheres negras com precisão poétic...
        </p>
        <div class="card-footer">
          <div class="meta">
            <span class="reviewer">Ana Lima</span>
            <span class="date-time">15 Jun 2026 · 12 min</span>
          </div>
          <span class="arrow">↗</span>
        </div>
      </div>
    </article>

    <!-- Card 2 -->
    <article class="card">
      <div class="tape tape-pink"></div>
      <div class="card-img-wrapper">
        <img src="caminho-da-imagem-2.jpg" alt="Ainda Estou Aqui">
        <span class="category-badge badge-blue">FILME</span>
      </div>
      <div class="card-content">
        <div class="stars">★★★★★</div>
        <h2 class="card-title">Ainda Estou Aqui</h2>
        <p class="author">Dir. Walter Salles</p>
        <p class="description">
          Fernanda Torres entrega o desempenho de uma vida. Salles constrói um retrato devastador de uma família sendo
          demolida pela ditadura, um frame de cada vez.
        </p>
        <div class="card-footer">
          <div class="meta">
            <span class="reviewer">Bruno Melo</span>
            <span class="date-time">10 Jun 2026 · 9 min</span>
          </div>
          <span class="arrow">↗</span>
        </div>
      </div>
    </article>

    <!-- Card 3 -->
    <article class="card">
      <div class="tape tape-purple"></div>
      <div class="card-img-wrapper">
        <img src="caminho-da-imagem-3.jpg" alt="Antígona">
        <span class="category-badge badge-brown">TEATRO</span>
      </div>
      <div class="card-content">
        <div class="stars">★★★★★</div>
        <h2 class="card-title">Antígona — Uma Tragédia Brasileira</h2>
        <p class="author">Cia. dos Atores, RJ</p>
        <p class="description">
          A releitura da tragédia grega com olhar para o Brasil contemporâneo é urgente, visceral e necessária. Uma das
          melhores montagens da última década.
        </p>
        <div class="card-footer">
          <div class="meta">
            <span class="reviewer">Pedro Alves</span>
            <span class="date-time">28 Mai 2026 · 11 min</span>
          </div>
          <span class="arrow">↗</span>
        </div>
      </div>
    </article>
  </div>
</section>
<%- include('partials/footer')%>