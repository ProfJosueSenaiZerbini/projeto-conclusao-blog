<!DOCTYPE html>
<html lang="pt-BR">
  <%- include('partials/head') %>
  <body>
    <main class="container">
      <h2><%= typeof titulo !== 'undefined' ? titulo : 'Login' %></h2>

      <!-- Exibe mensagem de erro se o controller enviar -->
      <% if (typeof erro !== 'undefined' && erro) { %>
        <p style="color: red; font-weight: bold;"><%= erro %></p>
      <% } %>

      <form action="http://localhost:3000/login" method="POST">
        <div>
          <label for="email">E-mail:</label>
          <input type="email" id="email" name="email" required placeholder="seu@email.com">
        </div>

        <br>

        <div>
          <label for="senha">Senha:</label>
          <input type="password" id="senha" name="senha" required placeholder="••••••••">
        </div>

        <br>

        <button type="submit">Entrar</button>
      </form>

      <p>Ainda não tem conta? <a href="http://localhost:3000/cadastro">Cadastre-se aqui</a></p>
    </main>
  </body>
</html>